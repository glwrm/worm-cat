---
import en from "../i18n/en";
const t = en;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Music from '../components/Music.astro';
import Dev from '../components/Dev.astro';
import Minecraft from '../components/Minecraft.astro';
import Wip from '../components/Wip.astro';

export const prerender = false;

const languageCookie = Astro.cookies.get("language")?.value;

if (languageCookie === "ca") {
    return Astro.redirect("/ca/");
}
---

<Layout>
	<Hero text={t.hero}/>
	<About text={t.about}/>
	<Music text={t.music}/>
	<!--<Dev text={t.dev}/>-->
	<!--<Minecraft text={t.minecraft}/>-->
	<Wip text={t.wip}/>
</Layout>
