---
interface Props {
    src: string;
    title?: string;
}

const {
    src,
    title = "Untitled"
} = Astro.props;
---

<div class="audio-player">
    <button class="play-button" aria-label="Play">
        ▶
    </button>

    <div class="player-main">
        <div class="track-title">{title}</div>

        <div class="progress-row">
            <div class="timeline">
                <div class="progress"></div>
            </div>

            <span class="time">0:00</span>
        </div>
    </div>

    <audio src={src}></audio>
</div>

<script>
    document.querySelectorAll(".audio-player").forEach((player) => {
        const audio = player.querySelector("audio") as HTMLAudioElement;
        const playButton = player.querySelector(".play-button") as HTMLButtonElement;
        const timeline = player.querySelector(".timeline") as HTMLElement;
        const progress = player.querySelector(".progress") as HTMLElement;
        const time = player.querySelector(".time") as HTMLElement;

        function formatTime(seconds: number) {
            if (!Number.isFinite(seconds)) return "0:00";

            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = Math.floor(seconds % 60);

            return `${minutes}:${remainingSeconds
                .toString()
                .padStart(2, "0")}`;
        }

        playButton.addEventListener("click", () => {
            if (audio.paused) {
                audio.play();
            } else {
                audio.pause();
            }
        });

        audio.addEventListener("play", () => {
            playButton.textContent = "❚❚";
            playButton.setAttribute("aria-label", "Pause");
        });

        audio.addEventListener("pause", () => {
            playButton.textContent = "▶";
            playButton.setAttribute("aria-label", "Play");
        });

        audio.addEventListener("timeupdate", () => {
            if (!audio.duration) return;

            const percentage =
                (audio.currentTime / audio.duration) * 100;

            progress.style.width = `${percentage}%`;
            time.textContent = formatTime(audio.currentTime);
        });

        timeline.addEventListener("click", (event) => {
            if (!audio.duration) return;

            const rect = timeline.getBoundingClientRect();
            const position = event.clientX - rect.left;
            const percentage = position / rect.width;

            audio.currentTime = percentage * audio.duration;
        });

        audio.addEventListener("ended", () => {
            progress.style.width = "0%";
            time.textContent = "0:00";
            playButton.textContent = "▶";
        });
    });
</script>

<style>
    .audio-player {
        --background: rgba(0, 0, 0, 0.25);
        --border: rgba(255, 255, 255, 0.15);
        --text: white;
        --secondary-text: rgba(255, 255, 255, 0.6);
        --accent: white;
        --progress-background: rgba(255, 255, 255, 0.18);
        --radius: 14px;

        width: 100%;
        box-sizing: border-box;

        display: flex;
        align-items: center;
        gap: 10px;

        padding: 10px 12px;

        background: var(--background);
        border: 1px solid var(--border);
        border-radius: var(--radius);

        color: var(--text);
    }

    .play-button {
        width: 32px;
        height: 32px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0;
        border: none;
        border-radius: 50%;

        background: var(--accent);
        color: black;

        font-size: 0.7rem;
        cursor: pointer;

        transition: transform 0.15s ease;
    }

    .play-button:hover {
        transform: scale(1.08);
    }

    .play-button:active {
        transform: scale(0.94);
    }

    .player-main {
        flex: 1;
        min-width: 0;
    }

    .track-title {
        margin-bottom: 6px;
        margin-right: 25px;

        font-size: 0.85rem;
        font-weight: 600;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .progress-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .timeline {
        height: 5px;

        flex: 1;
        min-width: 20px;

        background: var(--progress-background);
        border-radius: 999px;

        cursor: pointer;
        overflow: hidden;
    }

    .progress {
        width: 0%;
        height: 100%;

        background: var(--accent);
        border-radius: inherit;

        transition: width 0.1s linear;
    }

    .time {
        min-width: 28px;

        color: var(--secondary-text);
        font-size: 0.7rem;

        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    audio {
        display: none;
    }
</style>