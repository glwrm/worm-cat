---
import { getImage } from "astro:assets";
import grassBlock from "../assets/grassblock.png";
import serverRack from "../assets/serverrack.png";

const optimizedGrassBlock = await getImage({src: grassBlock,format: 'png',quality: 'high',width: 1920,});
const optimizedServerRack = await getImage({src: serverRack,format: 'png',quality: 'high',width: 1920,});
---

<div class="about">
    <h1>About</h1>
    <p>I'm glworm, though you might know me as ghostjusr. I like to start lots of things and never finish them. Explore some of the things I'm currently into::</p>
    <div class="hobbywrapper">
        <div style={`background-image: url('${optimizedServerRack.src}');`}><a href="#dev">
            <h2 style="margin-top: 13px; margin-right: 6px;">DEV</h2>
            <p style="font-size: 1.1rem; margin-right: 6px;">Random projects (Most unfinished)</p>
        </a></div>
        <div><a href="#music">
            <h2>MUSIC</h2>
            <p>Producing electronic music</p>
        </a></div>
        <div><a href="#cycling">
            <h2>CYCLING</h2>
            <p>Bike touring and bikepacking</p>
        </a></div>
        <div style={`background-image: url('${optimizedGrassBlock.src}');`}><a href="#minecraft">
            <h2 style="margin-top: 13px; margin-right: 6px;">MINCERAFT</h2>
            <p style="font-size: 1.1rem; margin-right: 6px;">Datapacking, modding, & messing <br>around</p>
        </a></div>
    </div>
</div>
<style>
    .about {
        grid-column: 2 / 4;
        grid-row: 2 / 3;
        box-sizing: border-box; 
        width: auto; 
        text-align: center;
        border-radius: 20px;
        padding: 0 15px;
        margin: 5px;
        color: white;
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        display: flex;
        flex-direction: column;
        min-width: 0;
        font-size: 1.2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        z-index: 5;
    }

    p {
        font-family: 'Roboto', sans-serif;
        font-size: 1.2rem;
        margin: 5px;
        margin-bottom: 20px;
        white-space: normal; 
        overflow-wrap: break-word;
        box-sizing: border-box;
    }


    .about:hover {
        transform: translateY(-6px) scale(1);
        filter: blur(0);
        box-shadow: 0 12px 40px rgba(255, 255, 255, 0.5);
    }

    h1 {
        font-family: 'Audiowide', cursive;
        font-size: 2.5rem;
        margin: 5px;
        margin-top: 20px;
        margin-right: 0;
    }

    a {
        color: inherit;
        text-decoration: none;
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    h2 {
        font-family: 'Audiowide', cursive;
        font-size: 1.3rem;
        margin: 5px;
        margin-top: 20px;
        margin-right: 0;
    }

    .hobbywrapper {
        display: flex;
        gap: 1rem;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

    .hobbywrapper div {
        flex: 1;
        max-height: 140px;
        text-align: center;
        border-radius: 20px;
        padding: 0 5px;
        margin: 5px;
        color: white;
        display: flex;
        flex-direction: column;
        font-size: 1.2rem;
        transition: transform 0.3s ease, filter 0.3s ease;
        cursor: pointer;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
    }

    .hobbywrapper div:hover {
        transform: translateY(-6px) scale(1);
        filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.5));
    }
</style>