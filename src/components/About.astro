---
import { getImage } from "astro:assets";
import { Image } from 'astro:assets';

import grassBlock from "../assets/grass_block.png";
import serverRack from "../assets/server_rack.png";
import kawaiispeaker from "../assets/kawaii_speaker.png";
import othercube from "../assets/other_cube.png";

const optimizedGrassBlock = await getImage({src: grassBlock,format: 'png',quality: 'high',width: 1920,});
const optimizedServerRack = await getImage({src: serverRack,format: 'png',quality: 'high',width: 1920,});
const optimizedOtherCube = await getImage({src: othercube,format: 'png',quality: 'high',width: 1920,});
---

<div id="about" style="backdrop-filter: blur(12px);">
    <h1>{Astro.props.text.title}</h1>
    <p>{Astro.props.text.description}</p>
    <div class="hobbywrapper">
        <div id="dev-hobby" style={`background-image: url('${optimizedServerRack.src}');`}><a href="#dev">
            <h2 style="margin-top: 13px; margin-right: 6px;">{Astro.props.text.hobby_dev}</h2>
            <p style="font-size: 1.1rem; margin-right: 6px;">{Astro.props.text.hobby_dev_desc}</p>
        </a></div>
        <div id="music-hobby"><a href="#music">
            <Image src={kawaiispeaker} alt="Kawaii Speaker" class="speaker-image" />
            <h2 style="margin-top: 25px; margin-right: 6px;">{Astro.props.text.hobby_music}</h2>
            <p style="font-size: 1.1rem; margin-right: 6px;">{Astro.props.text.hobby_music_desc}</p>
        </a></div>
        <div id="minecraft-hobby" style={`background-image: url('${optimizedGrassBlock.src}');`}><a href="#minecraft">
            <h2 style="margin-top: 13px; margin-right: 6px;">{Astro.props.text.hobby_minecraft}</h2>
            <p style="font-size: 1.1rem; margin-right: 6px;">{Astro.props.text.hobby_minecraft_desc}</p>
        </a></div>
        <div id="other-hobby" style={`background-image: url('${optimizedOtherCube.src}');`}><a href="#other">
            <h2 style="margin-top: 13px; margin-right: 6px;">{Astro.props.text.hobby_other}</h2>
            <p style="font-size: 1.1rem; margin-right: 6px;">{Astro.props.text.hobby_other_desc}</p>
        </a></div>
    </div>
</div>

<script>
    const devHobby = document.getElementById("dev-hobby");
    const musicHobby = document.getElementById("music-hobby");
    const minecraftHobby = document.getElementById("minecraft-hobby");
    const otherHobby = document.getElementById("other-hobby");

    const hobbyDivs = [
        document.getElementById("dev"),
        document.getElementById("music"),
        document.getElementById("minecraft"),
        document.getElementById("other")
    ].filter((div): div is HTMLElement => div !== null);

    function highlight(id: string) {
        // Remove the effect from every full hobby card that actually exists
        hobbyDivs.forEach((div) => {
            div.classList.remove("sim-hover");
        });

        // Find the corresponding full card
        const target = document.getElementById(id);

        if (!target) {
            console.warn(`Could not find full hobby card: #${id}`);
            return;
        }

        target.classList.add("sim-hover");

        setTimeout(() => {
            target.classList.remove("sim-hover");
        }, 1000);
    }

    devHobby?.addEventListener("click", () => {
        highlight("dev");
    });

    musicHobby?.addEventListener("click", () => {
        highlight("music");
    });

    minecraftHobby?.addEventListener("click", () => {
        highlight("minecraft");
    });

    otherHobby?.addEventListener("click", () => {
        highlight("other");
    });
</script>

<style>
    #about {
        grid-column: 2 / 4;
        grid-row: 2 / 3;
        box-sizing: border-box; 
        width: auto; 
        text-align: center;
        border-radius: 20px;
        padding: 0 15px;
        margin: 5px;
        color: white;
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        display: flex;
        flex-direction: column;
        min-width: 0;
        font-size: 1.2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        z-index: 5;
    }

    p {
        font-family: 'Roboto', sans-serif;
        font-size: 1.2rem;
        margin: 5px;
        margin-bottom: 20px;
        white-space: normal; 
        overflow-wrap: break-word;
        box-sizing: border-box;
    }


    #about:hover {
        transform: translateY(-6px) scale(1);
        filter: blur(0);
        box-shadow: 0 12px 40px rgba(255, 255, 255, 0.5);
    }

    h1 {
        font-family: 'Audiowide', cursive;
        font-size: 2.5rem;
        margin: 5px;
        margin-top: 20px;
        margin-right: 0;
    }

    a {
        color: inherit;
        text-decoration: none;
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    h2 {
        font-family: 'Audiowide', cursive;
        font-size: 1.3rem;
        margin: 5px;
        margin-top: 20px;
        margin-right: 0;
    }

    .hobbywrapper {
        display: flex;
        gap: 1rem;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

    .hobbywrapper div {
        position: relative;
        flex: 1;
        max-height: 140px;
        text-align: center;
        border-radius: 20px;
        padding: 0 5px;
        margin: 5px;
        color: white;
        display: flex;
        flex-direction: column;
        font-size: 1.2rem;
        transition: transform 0.3s ease, filter 0.3s ease;
        cursor: pointer;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
    }

    .hobbywrapper div:hover {
        transform: translateY(-6px) scale(1);
        filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.5));
    }

    .speaker-image {
        position: absolute;
        top: 42%;
        left: 50%;
        width: 100%;
        height: 100%;
        transform: translate(-50%, -50%);

        width: 83%;
        height: auto;
        
        z-index: -1;
    }
</style>