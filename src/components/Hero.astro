---
import { Image } from 'astro:assets';
import pfp from '../assets/glworm.jpg';

const currentLocale = Astro.currentLocale ?? "en";

// Language support
interface Props {
    text: {
        country: string;
        pfp_alt: string;
    };
}
---

<div class="hero">
    <div>
        <Image src={pfp} alt={Astro.props.text.pfp_alt}/>
        <h1>glworm <span>(status)</span></h1>
    </div>
    <div class="lang-selector">
        <a href="/" class:list={{ selectedlang: currentLocale === "en" }} data-language="en">EN</a>
        <span>&nbsp;•&nbsp;</span>
        <a href="/ca" class:list={{ selectedlang: currentLocale === "ca" }} data-language="ca">CA</a>
