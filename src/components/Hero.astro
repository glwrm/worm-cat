<script>
    document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach((link) => {
        link.addEventListener("click", () => {
            const language = link.dataset.language;

            if (language) {
                document.cookie = `language=${language}; path=/; max-age=31536000; SameSite=Lax`;
            }
        });
    });

    async function updateTypingPB() {
        try {
            const response = await fetch("/api/mk");

            if (!response.ok) {throw new Error(`HTTP ${response.status}`);}

            const data = await response.json();
            const wpm = document.querySelector("#wpm-typing");

            if (wpm) {wpm.textContent = `${data.wpm} WPM`;}
        } catch (error) {
            console.error("Failed to fetch Monkeytype data:", error);
        }
    }

    updateTypingPB();
    
</script>

<style>
    .hero {
        grid-column: 2 / 4;
        grid-row: 1 / 2;
        box-sizing: border-box;
        width: auto;
        text-align: center;
        border-radius: 20px;
        padding: 0 5px;
        margin: 5px;
        color: white;
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        display: flex;
        flex-direction: column;
        font-size: 1.2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        z-index: 5;
    }

    .hero:hover {
        transform: translateY(-6px) scale(1);
        filter: blur(0);
        box-shadow: 0 12px 40px rgba(255, 255, 255, 0.5);
    }

    .hero h1 {
        font-family: 'Audiowide', cursive;
        font-size: 2.5rem;
        margin: 5px;
        margin-top: 20px;
        margin-right: 0;
    }

    .hero img {
        width: 5rem;
        height: 5rem;
        border-radius: 20px;
        margin: 10px;
    }

    .hero h1 span {
        color: #567d82;
        font-size: 1.35rem;
        margin: 20px;
        margin-left: 0;
    }

    .hero div {
        display: flex;
    }

    .lang-selector {
        font-family: Arial;
        position: absolute;
        display: flex;
        justify-content: center;
        top: 20px;
        right: 20px;
    }

    .lang-selector a {
        color: inherit;
        text-decoration: none;
    }

    .selectedlang {
        font-weight: bold;
    }

    hr {
		width: 95%;
		border: 1px solid rgba(255, 255, 255, 0.5);
		margin: 5px 0 25px 0;
        align-self: center;
	}

    .chips {
        justify-content: center;
        align-items: start;
        margin: -5px 0px 15px 0px;
    }

    .infochip {
        margin: 0 10px;
    }
    
    .infochip a:hover {
        transform: translateY(-6px);
        text-shadow: 0px 0px 5px #ffffff;
    }

    .infochip a {
        color: inherit;
        text-decoration: none;
        display: flex;
        transition: transform 0.2s ease, text-shadow 0.2s ease;
    }

    .infochip svg {
        width: 25px;
        margin-right: 5px;
        filter: invert(0.75);
    }

    .infochip p {
        color: rgba(255, 255, 255, 0.75);
        font-size: 19px;
        margin: 0;
    }

    .socials {
        width: 100%;
        height: 1fr;
        margin: 2px;
        display: flex;
        align-content: center;
        justify-content: center;
    }

    .social {
        width: 65px;
        height: 65px;
        border-radius: 20px;
        padding: 2px;
        margin: 10px;
        background: rgba(0, 0, 0, 0.3);
        box-shadow: 0 5px 16px rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        font-size: 1.2rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .social:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    }

    .social:active {
        cursor: default;
    }

    .social svg {
        filter: invert(0.9);
        width: 75%;
    }
</style>